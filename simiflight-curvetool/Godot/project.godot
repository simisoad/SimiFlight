; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SimiFlight - SimiFoil"
config/version="Beta-0.9.5"
run/main_scene="uid://4no4pkrbhtp0"
run/print_header=false
run/enable_alt_space_menu=true
config/auto_accept_quit=false
config/features=PackedStringArray("4.5", "GL Compatibility")
run/low_processor_mode=true
boot_splash/show_image=false
config/icon="uid://rl53cq4u21el"
config/macos_native_icon="res://Icon/icon_256.icns"
config/windows_native_icon="res://Icon/icon_256.ico"

[autoload]

EventBus="*res://scripts/Autoload/EventBus.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/energy_saving/keep_screen_on=false
window/subwindows/embed_subwindows=false
window/stretch/scale_mode="integer"

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/folder_structure_export/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[folder_structure_export]

exclusions/excluded_dirs=["addons", ".godot", ".git", "build"]
exclusions/output_path="folder_structure.txt"

[physics]

2d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.09077018, 0.09076925, 0.10701763, 1)
