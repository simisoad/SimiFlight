; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SimiFlight Curve|LUT Tool"
run/main_scene="uid://j4mlp7cre765"
run/print_header=false
run/enable_alt_space_menu=true
config/features=PackedStringArray("4.5", "GL Compatibility")
run/low_processor_mode=true
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/Autoload/EventBus.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/borderless=true
window/size/extend_to_title=true
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/folder_structure_export/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[folder_structure_export]

exclusions/excluded_dirs=["addons", ".godot", ".git", "build"]
exclusions/output_path="folder_structure.txt"

[physics]

2d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
