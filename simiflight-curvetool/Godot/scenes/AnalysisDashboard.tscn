[sub_resource type="GDScript" id="GDScript_kuipa"]
script/source = "@tool
extends PanelContainer
@onready var chart_polar: SimpleChart = %ChartPolar
@export_tool_button(\"SetPos\") var set_pos_btn = set_pos
func _ready() -> void:
	set_pos()

func set_pos() -> void:
	position = Vector2(chart_polar.margin_left, chart_polar.size.y-chart_polar.margin_bottom-self.size.y)
"

